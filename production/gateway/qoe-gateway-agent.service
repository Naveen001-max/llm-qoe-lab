[Unit]
Description=LLM QoE Lab authenticated network profile agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/qoe-gateway/agent.env
ExecStart=/opt/qoe-gateway/venv/bin/uvicorn agent:app --host 0.0.0.0 --port 8090 --ssl-certfile /etc/qoe-gateway/gateway.crt --ssl-keyfile /etc/qoe-gateway/gateway.key
WorkingDirectory=/opt/qoe-gateway
Restart=on-failure
RestartSec=3
User=root
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
