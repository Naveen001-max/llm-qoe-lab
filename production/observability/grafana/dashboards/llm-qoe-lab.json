{
  "uid": "llm-qoe-lab",
  "title": "LLM QoE Lab \u2014 Runtime & Inference",
  "tags": [
    "llm",
    "qoe",
    "vllm"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "API TTFT p95 (server-observed)",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_qoe_ttft_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 TTFT"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Server E2E p95",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_qoe_stream_e2e_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 E2E"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "API admission queue p95",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_qoe_queue_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95 queue"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "API request rate",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (route,status) (rate(llm_qoe_requests_total[5m]))",
          "legendFormat": "{{route}} {{status}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "vLLM engine TTFT p95",
