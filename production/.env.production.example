APP_ENV=production
CONSENT_VERSION=1.0.0
# The API host's default route must point to the Ubuntu gateway; these endpoints are private inference-host addresses.
APP_NAME=LLM QoE Lab
PUBLIC_DOMAIN=qoe.example.org
DATABASE_URL=postgresql+asyncpg://qoe_app:CHANGE_ME@postgres:5432/llm_qoe
REDIS_URL=redis://redis:6379/0
JWT_SECRET=REPLACE_WITH_AT_LEAST_48_RANDOM_BYTES
ACCESS_TOKEN_MINUTES=30
COOKIE_SECURE=true
CORS_ORIGINS=https://qoe.example.org
JSONL_DIR=/var/lib/llm-qoe/events
LLM_BASE_URL=https://qoe-inference.lab:8001/v1
LLM_MODEL=llama-3.1-8b-instruct
LLM_MODEL_REPOSITORY=meta-llama/Llama-3.1-8B-Instruct
LLM_MODEL_REVISION=REPLACE_WITH_40_CHAR_COMMIT_SHA
SLM_BASE_URL=https://qoe-inference.lab:8002/v1
SLM_MODEL=qwen2.5-1.5b-instruct
SLM_MODEL_REPOSITORY=Qwen/Qwen2.5-1.5B-Instruct
SLM_MODEL_REVISION=REPLACE_WITH_40_CHAR_COMMIT_SHA
LLM_API_KEY=REPLACE_WITH_RANDOM_48_BYTE_SECRET
SLM_API_KEY=REPLACE_WITH_DIFFERENT_RANDOM_48_BYTE_SECRET
DEFAULT_MODEL=llm
VLLM_VERSION=0.34.0
VLLM_IMAGE_DIGEST=sha256:REPLACE_WITH_64_HEX_DIGEST
LLM_MAX_MODEL_LEN=8192
LLM_MAX_NUM_SEQS=16
SLM_MAX_MODEL_LEN=4096
SLM_MAX_NUM_SEQS=32
TEMPERATURE=0.0
TOP_P=1.0
INFERENCE_SEED=42
GATEWAY_CONTROL_URL=https://qoe-gateway.lab:8090
GATEWAY_HOST_IP=10.30.0.1
GATEWAY_TOKEN=REPLACE_WITH_THE_SAME_RANDOM_GATEWAY_AGENT_TOKEN
GATEWAY_CA_BUNDLE=/run/secrets/gateway-ca.crt
INFERENCE_CA_BUNDLE=/run/secrets/inference-ca.crt
INFERENCE_HOST_IP=10.20.0.20
REQUIRE_GATEWAY=true
MAX_PROMPT_CHARS=20000
MAX_OUTPUT_TOKENS=2048
RATE_LIMIT_PER_MINUTE=30
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD= # Leave empty; create the admin interactively with the CLI.
POSTGRES_DB=llm_qoe
POSTGRES_USER=qoe_app
POSTGRES_PASSWORD=CHANGE_ME
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
